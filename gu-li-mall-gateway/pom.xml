<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.shun.gu_li_mail</groupId>
        <artifactId>gu_li_mail</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>gu-li-mall-gateway</artifactId>
    <description>网关路由</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!--
          ⚠️ 严禁依赖 gu-li-mall-common：common 带 spring-boot-starter-web（Tomcat/WebMVC），
             与 Gateway 的 WebFlux 冲突（会启动失败或行为异常）。网关需要的公共能力单独放本模块里。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway</artifactId>
        </dependency>
        <!--
          负载均衡器：Gateway 的 lb:// 路由（含服务名自动路由）必需。
          注：Spring Cloud 2020+ 移除了 Ribbon，lb:// 依赖这个 starter；
          nacos-discovery 不会再自动带它，漏了会在请求时报「找不到实例/LoadBalancer 未配置」。
          版本由根 pom 的 spring-cloud-dependencies BOM 管，不写 <version>。
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- Actuator：网关自身探活（不要依赖 common，故这里单独引） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>
</project>