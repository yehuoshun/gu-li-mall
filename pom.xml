<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <groupId>com.shun.gu_li_mail</groupId>
    <artifactId>gu_li_mail</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>gu_li_mail</name>
    <description>谷粒商城</description>

    <properties>
        <!-- MyBatis-Plus：3.5.x 系列，Boot 3 用 spring-boot3-starter（已核实 Maven Central 最新 3.5.18，2026-10-27） -->
        <mybatis-plus.version>3.5.18</mybatis-plus.version>
        <!-- MPJ（icu.mhb 版多表 join 插件）不在 MP BOM 里，单独锁版本；2.1.3 为 Central 当前最新 -->
        <mybatis-plus-join.version>2.1.3</mybatis-plus-join.version>
    </properties>

    <modules>
        <module>gu-li-mall-common</module>
        <module>gu-li-mall-common-datasource</module>
        <module>gu-li-mall-gateway</module>
        <module>gu-li-mall-product</module>
        <module>gu-li-mall-member</module>
        <module>gu-li-mall-coupon</module>
        <module>gu-li-mall-ware</module>
        <module>gu-li-mall-order</module>
        <module>gu-li-mall-search</module>
        <module>gu-li-mall-cart</module>
        <module>gu-li-mall-seckill</module>
        <module>gu-li-mall-auth-server</module>
        <module>gu-li-mall-third-part</module>
    </modules>
    <packaging>pom</packaging>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
    </parent>

    <!--
      APT（注解处理器）必须「声明在真正编译实体的模块」才生效：处理器是编译期按模块跑的，
      且 provided 作用域不传递——只放在 common-datasource 里，业务模块的实体上写 @JoinChainModel 也不会生成链式类。
      放根 pom 的 <dependencies> 一句覆盖全部 13 个模块；provided 不会被包进产物。
      作用：为标了 @JoinChainModel 的实体生成 XxxChain（链式模式，MPJ 新特性）；没标的模块该处理器空跑。
    -->
    <dependencies>
        <dependency>
            <groupId>icu.mhb</groupId>
            <artifactId>mybatis-plus-join-processor</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块：版本随手工程走（子模块引用时不写 <version>） -->
            <dependency>
                <groupId>com.shun.gu_li_mail</groupId>
                <artifactId>gu-li-mall-common-datasource</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>2025.0.0.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>2025.0.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
              MyBatis-Plus BOM：统一管 MP 全家桶版本（starter / jsqlparser / generator 等）
              ⚠️ 必须带 <scope>import</scope>，否则整段无效
            -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-bom</artifactId>
                <version>${mybatis-plus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>icu.mhb</groupId>
                <artifactId>mybatis-plus-join-processor</artifactId>
                <version>${mybatis-plus-join.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>